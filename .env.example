DATABASE_URL="mysql://hiryu_user:GANTI_PASSWORD_ANDA@localhost:3306/hiryutechno"
SITE_URL="http://localhost:3000"


# Admin session
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12

# One-time token to create the FIRST Super Admin at /dashboard-admin/signup.
# Generate with: openssl rand -hex 24 . Clear it after the Super Admin exists.
BOOTSTRAP_TOKEN=""

# Uploads. In production use a PERSISTENT volume (local container disks are ephemeral).
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_MB=8

# Optional: used by `npm run db:seed` to create the first Super Admin (no default password)
SEED_ADMIN_NAME=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# ── Contact form → company email (SMTP) ────────────────────────────────────────
# Alur: klien isi form → dikirim ke email company → disimpan ke database sebagai riwayat.
# Jika SMTP_HOST kosong, pesan tetap tersimpan di MySQL dan admin melihat status
# "Not configured" (tidak pernah "sent" palsu).

# --- Pilih SALAH SATU contoh di bawah, lalu isi nilainya ---

# A) Gmail (wajib App Password 16 digit, bukan password login; aktifkan 2-Step Verification dulu)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="andrean3602@gmail.com"
SMTP_PASS=""

# B) Hosting / cPanel (hapus blok A jika memakai ini)
# SMTP_HOST="mail.domainanda.com"
# SMTP_PORT=465
# SMTP_SECURE="true"
# SMTP_USER="info@domainanda.com"
# SMTP_PASS="password-email-anda"

# Alamat pengirim. Kosongkan untuk memakai SMTP_USER.
# Contoh: MAIL_FROM="Website Hiryu <info@domainanda.com>"
# (Gmail/Outlook hanya mengizinkan alamat yang sama dengan SMTP_USER.)
MAIL_FROM="Website Hiryu <andrean3602@gmail.com>"

# Penerima cadangan bila "Company Email" di Dashboard > Settings kosong.
# Boleh lebih dari satu, pisahkan dengan koma.
CONTACT_NOTIFY_EMAIL=""