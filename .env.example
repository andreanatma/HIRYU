# Database (MySQL 8+). Never commit the real .env file.
DATABASE_URL="mysql://hiryu_user:CHANGE_PASSWORD@localhost:3306/hiryutechno"

# Public site URL (used for canonical URLs, sitemap, Open Graph)
SITE_URL="http://localhost:3000"

# Admin session
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12

# One-time token to create the FIRST Super Admin at /dashboard-admin/signup.
# Generate with: openssl rand -hex 24 . Clear it after the Super Admin exists.
BOOTSTRAP_TOKEN=""

# Uploads. In production use a PERSISTENT volume (local container disks are ephemeral).
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_MB=8

# Optional: used by `npm run db:seed` to create the first Super Admin (no default password)
SEED_ADMIN_NAME=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Optional contact-form email notification (Resend). If any value is missing, messages are still saved
# to MySQL and the admin sees "Not configured" as the email status (never a false "sent").
RESEND_API_KEY=""
MAIL_FROM=""
CONTACT_NOTIFY_EMAIL=""
